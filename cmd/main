#!/bin/sh
set -eu

LOG_FILE="${TRIM_PKGVAR:-/tmp}/zjjx.log"
PID_FILE="${TRIM_PKGVAR:-/tmp}/zjjx.pid"
SOCKET_PATH="${TRIM_APPDEST}/app.sock"
APP_DIR="${TRIM_APPDEST}/app/server"

mkdir -p "$(dirname "$LOG_FILE")"
export PATH="/var/apps/nodejs_v22/target/bin:${PATH:-}"
export SOCKET_PATH
export ZJJX_CONFIG_DIR="${TRIM_PKGETC}"
export ZJJX_VAR_DIR="${TRIM_PKGVAR}"
export TRIM_DATA_ACCESSIBLE_PATHS="${TRIM_DATA_ACCESSIBLE_PATHS:-}"

log() { printf '%s - %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$LOG_FILE"; }

running() {
  [ -f "$PID_FILE" ] || return 1
  pid="$(sed -n '1p' "$PID_FILE" | tr -d '[:space:]')"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

start_app() {
  if running; then exit 0; fi
  rm -f "$PID_FILE" "$SOCKET_PATH"
  mkdir -p "${TRIM_PKGVAR}" "${TRIM_PKGETC}"
  log "Starting ZJJX ${TRIM_APPVER:-unknown}"
  cd "$APP_DIR"
  node index.mjs >> "$LOG_FILE" 2>&1 &
  echo "$!" > "$PID_FILE"
  sleep 1
  if ! running; then
    printf '%s\n' "ZJJX 启动失败，请查看应用日志。" > "${TRIM_TEMP_LOGFILE:-$LOG_FILE}"
    exit 1
  fi
}

stop_app() {
  if ! running; then rm -f "$PID_FILE" "$SOCKET_PATH"; exit 0; fi
  pid="$(sed -n '1p' "$PID_FILE" | tr -d '[:space:]')"
  kill -TERM "$pid" 2>> "$LOG_FILE" || true
  count=0
  while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 10 ]; do sleep 1; count=$((count + 1)); done
  if kill -0 "$pid" 2>/dev/null; then kill -KILL "$pid" 2>> "$LOG_FILE" || true; fi
  rm -f "$PID_FILE" "$SOCKET_PATH"
}

case "${1:-}" in
  start) start_app ;;
  stop) stop_app ;;
  status) running && exit 0 || exit 3 ;;
  *) printf '%s\n' "用法：main {start|stop|status}" > "${TRIM_TEMP_LOGFILE:-$LOG_FILE}"; exit 1 ;;
esac
