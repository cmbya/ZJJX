#!/bin/sh
set -u

PKGVAR="${TRIM_PKGVAR:-/tmp}"
APPDEST="${TRIM_APPDEST:-}"
CONFIG_DIR="${TRIM_PKGETC:-/tmp/zjjx-etc}"
LOG_FILE="${PKGVAR}/zjjx.log"
PID_FILE="${PKGVAR}/zjjx.pid"
ERROR_FILE="${TRIM_TEMP_LOGFILE:-}"
SOCKET_PATH="${APPDEST:+${APPDEST}/app.sock}"
# fnOS 的 TRIM_APPDEST 指向安装后的 target 目录；源码中的 app/ 会被去掉。
APP_DIR="${APPDEST:+${APPDEST}/server}"

mkdir -p "$PKGVAR" 2>/dev/null || true

log() {
  printf '%s [ZJJX] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE" 2>/dev/null || true
}

fail() {
  message="$1"
  log "ERROR: $message"
  if [ -n "$ERROR_FILE" ]; then
    {
      printf '%s\n' "ZJJX 启动失败：$message"
      printf '%s\n' "详细日志文件：$LOG_FILE"
      printf '%s\n' "最近 60 行："
      tail -n 60 "$LOG_FILE" 2>/dev/null || true
    } > "$ERROR_FILE" 2>/dev/null || true
  fi
  return 1
}

running() {
  [ -f "$PID_FILE" ] || return 1
  pid="$(sed -n '1p' "$PID_FILE" 2>/dev/null | tr -d '[:space:]')"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

start_app() {
  [ -n "$ERROR_FILE" ] && rm -f "$ERROR_FILE" 2>/dev/null || true
  log "----- start requested -----"
  log "env: appname=${TRIM_APPNAME:-unknown} version=${TRIM_APPVER:-unknown} status=${TRIM_APP_STATUS:-unknown} arch=${TRIM_SYS_ARCH:-unknown}"
  log "paths: appdest=${APPDEST:-<empty>} appdir=${APP_DIR:-<empty>} config=${CONFIG_DIR} var=${PKGVAR} socket=${SOCKET_PATH:-<empty>}"
  log "authorized_roots=${TRIM_DATA_ACCESSIBLE_PATHS:-<empty>}"

  if running; then
    log "already running"
    return 0
  fi
  rm -f "$PID_FILE" "$SOCKET_PATH" 2>/dev/null || true

  [ -n "$APPDEST" ] || fail "TRIM_APPDEST 未设置" || return 1
  [ -d "$APP_DIR" ] || fail "应用目录不存在：$APP_DIR" || return 1

  export PATH="/var/apps/nodejs_v22/target/bin:${PATH:-}"
  NODE_BIN="$(command -v node 2>/dev/null || true)"
  log "node_path=${NODE_BIN:-<not-found>} path=$PATH"
  [ -n "$NODE_BIN" ] || fail "找不到 Node.js 运行时，请确认 nodejs_v22 已安装" || return 1
  if ! "$NODE_BIN" --version >> "$LOG_FILE" 2>&1; then
    fail "Node.js 无法执行"
    return 1
  fi

  export SOCKET_PATH
  export ZJJX_CONFIG_DIR="$CONFIG_DIR"
  export ZJJX_VAR_DIR="$PKGVAR"
  export TRIM_DATA_ACCESSIBLE_PATHS="${TRIM_DATA_ACCESSIBLE_PATHS:-}"
  cd "$APP_DIR" 2>> "$LOG_FILE" || { fail "无法进入应用目录：$APP_DIR"; return 1; }
  log "launch: $NODE_BIN index.mjs"
  "$NODE_BIN" index.mjs >> "$LOG_FILE" 2>&1 &
  pid="$!"
  echo "$pid" > "$PID_FILE"
  log "child_pid=$pid"

  count=0
  while [ "$count" -lt 5 ]; do
    if running; then
      log "started successfully after ${count}s"
      return 0
    fi
    sleep 1
    count=$((count + 1))
  done
  log "child process exited during startup"
  fail "Node.js 进程启动后立即退出"
  return 1
}

stop_app() {
  log "----- stop requested -----"
  if ! running; then
    rm -f "$PID_FILE" "$SOCKET_PATH" 2>/dev/null || true
    log "not running"
    return 0
  fi
  pid="$(sed -n '1p' "$PID_FILE" 2>/dev/null | tr -d '[:space:]')"
  log "stopping pid=$pid"
  kill -TERM "$pid" 2>> "$LOG_FILE" || true
  count=0
  while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 10 ]; do
    sleep 1
    count=$((count + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    log "graceful stop timed out; sending SIGKILL"
    kill -KILL "$pid" 2>> "$LOG_FILE" || true
  fi
  rm -f "$PID_FILE" "$SOCKET_PATH" 2>/dev/null || true
  log "stopped"
}

case "${1:-}" in
  start) start_app ;;
  stop) stop_app ;;
  status) running && exit 0 || exit 3 ;;
  *) fail "未知命令：${1:-<empty>}"; exit 1 ;;
esac
